# Public values: baked into the build and visible in the browser. Never put a secret here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=/api
# Host that tenant sites hang off, with the port when it has one: gentrep.xyz, staging.gentrep.xyz, localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# true shows a "draft, not yet reviewed" banner on the terms and privacy pages. Set false only after a lawyer or the DPO has read them.
NEXT_PUBLIC_LEGAL_DRAFT=true
# Local development only: send /api to the API process (leave unset on Vercel)
API_ORIGIN=http://localhost:4000
# Terms and privacy pages: who runs the platform. A visible [bracket] on those pages means "not set yet".
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_DPO_EMAIL=
