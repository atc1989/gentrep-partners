# local | staging | production. Anything unset counts as production, so a missing value never switches on local shortcuts.
APP_ENV=local
# resend (staging, production) | console | memory (console and memory only with APP_ENV=local)
EMAIL_MODE=console
# Host that tenant sites hang off, with the port when it has one: gentrep.xyz, staging.gentrep.xyz, localhost:3000
ROOT_DOMAIN=localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Auth admin only (sign-up links, first super admin). Never reads or writes business data. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# A sender on the domain verified in Resend, for example "Gentrep <no-reply@mail.gentrep.xyz>"
EMAIL_FROM=
PORT=4000
